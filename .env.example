PORT=3000
KEY_SECRET=SecretEtronic
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# En producción: define la URL del frontend (admite varias separadas por coma)
# FRONTEND_URL=https://etronic.com.mx,https://www.etronic.com.mx

# Conexión a BD (usa DATABASE_URL en Render o las variables sueltas)
# DATABASE_URL=postgres://usuario:password@host:5432/nombre
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=etronic_bd
# Opcional: forzar SSL en PostgreSQL (true | false). Por defecto false en localhost (cPanel) y true en nube.
# DB_SSL=false

# Cuenta administradora inicial para /adminetronic (entre comillas si incluye #)
ADMIN_EMAIL="adminetronic27@gmail.com"
ADMIN_PASSWORD="TuPasswordAdminSegura"

# Opcional: forzar SameSite (lax | none | strict)
# COOKIE_SAMESITE=lax

# Opcional: duración de la sesión en días.
#   SESSION_TTL_DAYS  -> sin "Recordarme" (cookie de sesión + JWT). Por defecto 1.
#   REMEMBER_TTL_DAYS -> con "Recordarme" (cookie persistente + renovación). Por defecto 30.
# SESSION_TTL_DAYS=1
# REMEMBER_TTL_DAYS=30
